# =============================================================================
# ISSB Preparation Platform — environment template
# =============================================================================
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# MUST NEVER be committed. Generate secrets with:  openssl rand -hex 32
# The app validates every variable at startup and refuses to run if any are
# missing or malformed (see src/lib/env/schema.ts).
# -----------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
APP_ENV=development

# --- Network ---
# Preferred port. If it is busy the start scripts pick the next free port and
# report it. All ports are documented in docs/PORTS.md.
APP_PORT=4310
APP_HOST=127.0.0.1
APP_BASE_URL=http://127.0.0.1:4310

# --- Database (dedicated DB + least-privilege user; see scripts/db-setup.sh) ---
DATABASE_URL=postgresql://issb_app:CHANGE_ME@127.0.0.1:5432/issb_dev
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_SECONDS=15

# --- Redis (dedicated logical DB index so other projects are unaffected) ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB=14

# --- Storage (uploads live OUTSIDE the web root) ---
STORAGE_DIR=./storage
BACKUP_DIR=./backups

# --- Logging ---
LOG_LEVEL=info

# --- Secrets (generate with: openssl rand -hex 32) ---
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- AI providers (adapters arrive in Phase 5; leave blank until then) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
